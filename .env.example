DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/halong_cruise_advisor"
REDIS_URL="redis://localhost:6379"
# Production always uses Redis. Local/test defaults to memory unless explicitly set to redis.
RATE_LIMIT_BACKEND="memory"
# Number of trusted reverse proxies that append to X-Forwarded-For.
# Production must set this and must not expose the app directly around that proxy chain.
TRUSTED_PROXY_HOPS="1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional exact browser origins under your control. No wildcards or paths.
# Production requires the canonical HTTPS origin above.
ADDITIONAL_STAFF_ORIGINS=""
# Disabled by default. Only enable temporarily for a reviewed migration client.
# Even legacy staff writes require an explicitly trusted Origin header.
ENABLE_LEGACY_ADMIN_API_KEY="false"
ADMIN_API_KEY=""
BOOKING_WEBHOOK_URL=""
PAYMENT_WEBHOOK_SECRET="replace-with-a-long-random-secret"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
