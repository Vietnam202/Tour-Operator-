DirectoryIndex index.html index.php
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:docs|tests|verification)/ - [F,L]
RewriteRule ^api/(?:bin|lib|migrations)/ - [F,L]
RewriteRule ^api/(?:config(?:\.example)?\.php|install\.php)$ - [F,L]
RewriteRule ^(?:setup\.php|README\.md|VERSION)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "^(index\.html|service-worker\.js|manifest\.json|offline\.html)$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>
