generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CruiseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  NEW
  CONTACTED
  QUOTED
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  FULL
  REFUND
}

enum PaymentEventStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Cruise {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  summary     String?
  route       String
  stars       Int          @default(5)
  rating      Float        @default(0)
  reviewCount Int          @default(0)
  badge       String?
  heroImage   String?
  status      CruiseStatus @default(DRAFT)
  cabins      Cabin[]
  departures  Departure[]
  bookings    BookingInquiry[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Cabin {
  id          String   @id @default(cuid())
  cruiseId    String
  cruise      Cruise   @relation(fields: [cruiseId], references: [id], onDelete: Cascade)
  name        String
  sizeSqm     Int?
  description String?
  capacity    Int      @default(2)
  basePrice   Int
  childRatePct Int     @default(70)
  singleSupplement Int @default(0)
  currency    String   @default("USD")
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cruiseId])
}

model Departure {
  id             String   @id @default(cuid())
  cruiseId       String
  cruise         Cruise   @relation(fields: [cruiseId], references: [id], onDelete: Cascade)
  departureDate  DateTime
  durationNights Int
  priceFrom      Int
  holidaySurcharge Int    @default(0)
  currency       String   @default("USD")
  cabinsLeft     Int?
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([cruiseId, departureDate])
}

model BookingInquiry {
  id              String        @id @default(cuid())
  reference       String        @unique
  cruiseId        String?
  cruise          Cruise?       @relation(fields: [cruiseId], references: [id], onDelete: SetNull)
  cruiseName      String
  cabinName       String?
  departureDate   DateTime
  durationNights  Int
  departureId     String?
  inventoryCommitted Boolean @default(false)
  adults          Int
  children        Int           @default(0)
  primaryGuest    String
  nationality     String?
  email           String
  phone           String?
  transferType    String?
  specialRequests String?
  estimatedTotal  Int?
  quotedSubtotal  Int?
  quotedSurcharge Int?
  quotedTransfer  Int?
  currency        String        @default("USD")
  status          BookingStatus @default(NEW)
  paymentStatus   PaymentStatus @default(UNPAID)
  depositAmount   Int?
  balanceAmount   Int?
  amountPaid      Int           @default(0)
  amountRefunded  Int           @default(0)
  payments        PaymentTransaction[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}


model PaymentTransaction {
  id              String             @id @default(cuid())
  bookingId       String
  booking         BookingInquiry     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind            PaymentKind
  status          PaymentEventStatus @default(PENDING)
  provider        String
  providerRef     String?
  idempotencyKey  String             @unique
  amount          Int
  currency        String             @default("USD")
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([bookingId, createdAt])
  @@index([provider, providerRef])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  payload         Json?
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  @@unique([provider, externalEventId])
  @@index([createdAt])
}
