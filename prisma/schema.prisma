generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CruiseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  NEW
  CONTACTED
  QUOTED
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  FULL
  REFUND
}

enum PaymentEventStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentRequestStatus {
  ACTIVE
  PAID
  EXPIRED
  CANCELLED
}

enum StaffRole {
  ADMIN
  OPERATIONS
  SALES
  FINANCE
}

enum ExpenseCategory {
  SUPPLIER
  TRANSFER
  GUIDE
  COMMISSION
  BANK_FEE
  REFUND_COST
  OTHER
}

enum PayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Cruise {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  summary     String?
  route       String
  stars       Int          @default(5)
  rating      Float        @default(0)
  reviewCount Int          @default(0)
  badge       String?
  heroImage   String?
  status      CruiseStatus @default(DRAFT)
  supplierId  String?
  supplier    Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  cabins      Cabin[]
  departures  Departure[]
  bookings    BookingInquiry[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  legalName   String?
  contactName String?
  email       String?
  phone       String?
  currency    String   @default("USD")
  notes       String?
  isActive    Boolean  @default(true)
  cruises     Cruise[]
  payables    SupplierPayable[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Cabin {
  id          String   @id @default(cuid())
  cruiseId    String
  cruise      Cruise   @relation(fields: [cruiseId], references: [id], onDelete: Cascade)
  name        String
  sizeSqm     Int?
  description String?
  capacity    Int      @default(2)
  basePrice   Int
  netCost     Int?
  childRatePct Int     @default(70)
  singleSupplement Int @default(0)
  currency    String   @default("USD")
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cruiseId])
}

model Departure {
  id             String   @id @default(cuid())
  cruiseId       String
  cruise         Cruise   @relation(fields: [cruiseId], references: [id], onDelete: Cascade)
  departureDate  DateTime
  durationNights Int
  priceFrom      Int
  netCostFrom    Int?
  holidaySurcharge Int    @default(0)
  currency       String   @default("USD")
  cabinsLeft     Int?
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([cruiseId, departureDate])
}

model BookingInquiry {
  id              String        @id @default(cuid())
  reference       String        @unique
  cruiseId        String?
  cruise          Cruise?       @relation(fields: [cruiseId], references: [id], onDelete: SetNull)
  cruiseName      String
  cabinName       String?
  departureDate   DateTime
  durationNights  Int
  departureId     String?
  inventoryCommitted Boolean @default(false)
  adults          Int
  children        Int           @default(0)
  primaryGuest    String
  nationality     String?
  email           String
  phone           String?
  transferType    String?
  specialRequests String?
  estimatedTotal  Int?
  quotedSubtotal  Int?
  quotedSurcharge Int?
  quotedTransfer  Int?
  quotedCost      Int?
  quotedMargin    Int?
  currency        String        @default("USD")
  status          BookingStatus @default(NEW)
  paymentStatus   PaymentStatus @default(UNPAID)
  depositAmount   Int?
  balanceAmount   Int?
  amountPaid      Int           @default(0)
  amountRefunded  Int           @default(0)
  assignedToId    String?
  assignedTo      StaffUser?    @relation("BookingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  followUpAt      DateTime?
  internalNotes   String?
  payments        PaymentTransaction[]
  paymentRequests PaymentRequest[]
  expenses        BookingExpense[]
  supplierPayables SupplierPayable[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([assignedToId, followUpAt])
}


model PaymentTransaction {
  id              String             @id @default(cuid())
  bookingId       String
  booking         BookingInquiry     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind            PaymentKind
  status          PaymentEventStatus @default(PENDING)
  provider        String
  providerRef     String?
  idempotencyKey  String             @unique
  amount          Int
  currency        String             @default("USD")
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([bookingId, createdAt])
  @@index([provider, providerRef])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  payload         Json?
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  @@unique([provider, externalEventId])
  @@index([createdAt])
}


model PaymentRequest {
  id          String               @id @default(cuid())
  bookingId   String
  booking     BookingInquiry       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  token       String               @unique
  kind        PaymentKind
  amount      Int
  currency    String               @default("USD")
  status      PaymentRequestStatus @default(ACTIVE)
  expiresAt   DateTime?
  providerUrl String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([bookingId, createdAt])
  @@index([status, expiresAt])
}


model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         StaffRole @default(OPERATIONS)
  isActive     Boolean   @default(true)
  sessions     StaffSession[]
  assignedBookings BookingInquiry[] @relation("BookingAssignee")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model StaffSession {
  id        String    @id @default(cuid())
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}


model BookingExpense {
  id          String          @id @default(cuid())
  bookingId   String
  booking     BookingInquiry  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  description String?
  amount      Int
  currency    String          @default("USD")
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([bookingId, createdAt])
  @@index([category, createdAt])
}

model SupplierPayable {
  id          String        @id @default(cuid())
  bookingId   String
  booking     BookingInquiry @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  amount      Int
  paidAmount  Int           @default(0)
  currency    String        @default("USD")
  status      PayableStatus @default(OPEN)
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([bookingId, createdAt])
  @@index([supplierId, status, dueDate])
}
