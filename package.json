{
  "name": "halong-cruise-advisor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "smoke": "sh scripts/smoke.sh",
    "test:integration": "tsx --test --test-concurrency=1 tests/*.integration.test.ts",
    "notifications:process": "tsx scripts/process-notification-outbox.ts",
    "notifications:once": "tsx scripts/process-notification-outbox.ts --once"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "@prisma/client": "^6.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "prisma": "^6.8.2",
    "tsx": "^4.19.3"
  },
  "engines": {
    "node": ">=20 <21"
  }
}
